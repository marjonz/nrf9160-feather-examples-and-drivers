&i2c2 {

	sts4x: sts4x@44 {
		compatible = "sensirion,sts4x";
		reg = <0x44>;
		repeatability = <2>;
	};
};

&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    sck-pin = <19>;
    mosi-pin = <21>;
    miso-pin = <22>;

    epaper_spi: wavshare_4_26@0 {
        compatible = "spi-device";
        reg = <0>;
        spi-max-frequency = <4000000>;
        label = "EPAPER_SPI";

		rst-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
		data-cmd-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
		busy-in-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
	    cs-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
	};
};

