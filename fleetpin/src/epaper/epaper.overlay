&spi2 {
    status = "okay";

    sck-pin = <19>;
    mosi-pin = <21>;
    miso-pin = <22>;
    
    epaper_spi: epaper_spi@0 {
        compatible = "epaper_spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        label = "EPAPER_SPI";

		rst-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
		dc-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
        cs-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
	};
};
